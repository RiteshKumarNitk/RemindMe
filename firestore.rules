rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Households --------------------------------------------------------
    //
    // The household id is an opaque short handle, NOT a secret. Security lives
    // here: every read of household data requires a membership record, and
    // membership can only be obtained by consuming a single-use invitation
    // token (see /invitations below). Removing a member deletes their record,
    // which immediately revokes their access on the next request.

    function signedIn() {
      return request.auth != null;
    }

    // A membership record exists for the caller in this household.
    function isMember(householdId) {
      return signedIn() && exists(
        /databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid)
      );
    }

    // The caller's own membership record says role == 'owner'.
    function isOwner(householdId) {
      return signedIn() && get(
        /databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid)
      ).data.role == 'owner';
    }

    match /households/{householdId} {
      // Only members may read the household document.
      allow read: if isMember(householdId);

      // Anyone signed in can create a household, but only as its owner and
      // only when it does not already exist (create — not update — enforces
      // the "must not exist" part; the client also runs this in a txn).
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      // The household document itself is immutable after creation (all
      // mutable state lives in subcollections). No deletes over the wire.
      allow update, delete: if false;

      // ---- Members ------------------------------------------------------
      match /members/{memberId} {
        // Any member can see who else is in the family.
        allow read: if isMember(householdId);

        // You may only create YOUR OWN membership record, tagged with your
        // uid and this household. Either:
        //  - as a plain 'member' — acceptInvitation() does this inside a
        //    transaction that also consumes the single-use invitation token; or
        //  - as the 'owner' — but only the household's declared ownerUid, and
        //    only at creation time (createHousehold() writes the household doc
        //    and this record in one transaction).
        allow create: if signedIn()
          && memberId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.householdId == householdId
          && (
            (
              request.resource.data.role == 'member' &&
              // The invitation named by inviteHash was consumed by me, for
              // THIS household, in this same commit. This is what stops a
              // client from writing itself a membership without an invite.
              getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.inviteHash)).data.used == true &&
              getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.inviteHash)).data.usedBy == request.auth.uid &&
              getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.inviteHash)).data.householdId == householdId
            ) ||
            (
              request.resource.data.role == 'owner' &&
              get(/databases/$(database)/documents/households/$(householdId))
                .data.ownerUid == request.auth.uid
            )
          );

        // A member may edit only their own record, and may not change their
        // own role (no self-promotion to owner).
        allow update: if signedIn()
          && memberId == request.auth.uid
          && request.resource.data.role == resource.data.role;

        // You can remove yourself (leave), or — if you are the owner —
        // remove any non-owner member. The owner cannot be removed.
        allow delete: if signedIn() && (
          (memberId == request.auth.uid && resource.data.role != 'owner') ||
          (isOwner(householdId) && resource.data.role != 'owner')
        );
      }

      // ---- Shared medical data --------------------------------------------
      // Members-only. Application-level per-member sharing permissions
      // (members/{uid}.permissions) decide what the caregiver dashboard
      // surfaces; the rules guarantee non-members see nothing at all.
      match /medicines/{medicineId} {
        allow read, write: if isMember(householdId);
      }
      match /doses/{doseId} {
        allow read, write: if isMember(householdId);
      }
    }

    // ---- Invitations ------------------------------------------------------
    //
    // Doc id is sha256(token). The plaintext token lives only in the QR, so
    // possessing the doc id already implies possessing (a hash of) the token.

    match /invitations/{tokenHash} {
      // Read to validate a scanned token.
      allow get: if signedIn();
      allow list: if false;

      // The creator sets up the invite for a household they own.
      allow create: if signedIn()
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.used == false;

      // Consume: flip used=false -> true and stamp who/when. Nothing else may
      // change, and it can only be consumed once.
      allow update: if signedIn()
        && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.householdId == resource.data.householdId
        && request.resource.data.creatorUid == resource.data.creatorUid;

      // Creator may delete their own invite; expired-cleanup also runs as the
      // creator.
      allow delete: if signedIn()
        && resource.data.creatorUid == request.auth.uid;
    }
  }
}
