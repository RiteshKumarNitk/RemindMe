rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A household document holds `members`: a map { uid: { role, joinedAt, fcmToken } }.
    match /households/{code} {
      // Only existing members can read.
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.members.keys();

      // Anyone signed in can create a brand-new household.
      allow create: if request.auth != null;

      // Existing members can update; a new user may also update *to join*,
      // i.e. when they add their own uid to `members`.
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members.keys() ||
        request.auth.uid in request.resource.data.members.keys()
      );

      match /medicines/{medicineId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in
            get(/databases/$(database)/documents/households/$(code)).data.members.keys();
      }

      match /doses/{doseId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in
            get(/databases/$(database)/documents/households/$(code)).data.members.keys();
      }
    }
  }
}
