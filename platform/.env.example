# =============================================================================
# DoseWise Healthcare Platform — environment variables (example)
# Copy to `.env` and fill in. NEVER commit `.env`.
# =============================================================================

# --- Database (Neon PostgreSQL) ----------------------------------------------
# Pooled connection (PgBouncer) used by the running app. Note `pgbouncer=true`
# and a bounded `connection_limit` for serverless/edge safety.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/dosewise?sslmode=require&pgbouncer=true&connection_limit=10"

# Direct (non-pooled) connection — REQUIRED by `prisma migrate` / introspection.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/dosewise?sslmode=require"

# --- Auth: session & token signing -----------------------------------------
# 32+ byte random secrets. Generate: `openssl rand -base64 48`
AUTH_SESSION_SECRET="CHANGE_ME_web_cookie_session_secret"
JWT_ACCESS_SECRET="CHANGE_ME_access_token_signing_secret"
JWT_REFRESH_SECRET="CHANGE_ME_refresh_token_signing_secret"
JWT_ACCESS_TTL="900"          # seconds (15 min)
JWT_REFRESH_TTL="2592000"     # seconds (30 days)
JWT_ISSUER="dosewise-platform"

# Argon2id tuning (argon2 npm). Defaults are sane; override only if benchmarked.
ARGON2_MEMORY_KIB="19456"
ARGON2_TIME_COST="2"
ARGON2_PARALLELISM="1"

# --- Google OAuth (email/password works without this) ----------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URL="http://localhost:3000/api/auth/google/callback"

# --- App -------------------------------------------------------------------
APP_BASE_URL="http://localhost:3000"
NODE_ENV="development"
# Comma-separated allowed origins for the Flutter app / other clients (CORS).
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# --- Rate limiting (in-process token bucket for MVP; no Redis) ------------
RATE_LIMIT_AUTH_PER_MIN="10"
RATE_LIMIT_DEFAULT_PER_MIN="120"

# --- Notifications (all optional in MVP; features degrade gracefully) -----
# Firebase Cloud Messaging server credentials (push transport only).
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""
# Email / SMS / WhatsApp providers are NOT configured in MVP (spec §19).

# Notification dispatcher (cron-driven; see NOTIFICATION_ARCHITECTURE.md).
# Shared secret required in the `X-Cron-Key` header of the dispatch endpoint.
NOTIFICATIONS_CRON_SECRET="CHANGE_ME_dispatch_endpoint_shared_secret"
NOTIFICATIONS_DISPATCH_BATCH="100"         # rows processed per invocation
NOTIFICATIONS_CLAIM_TIMEOUT_MIN="10"       # stale SENDING rows reaped after this
NOTIFICATIONS_MAX_ATTEMPTS="5"
# Dev-only in-process fallback dispatcher (never rely on this in production):
NOTIFICATIONS_INPROCESS_DISPATCH="false"

# --- Object storage (documents) — not used in Phase 0 --------------------
STORAGE_PROVIDER="local-dev"   # local-dev | s3 | gcs
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# --- Observability -------------------------------------------------------
LOG_LEVEL="info"
# SENTRY_DSN=""
