// =============================================================================
// DoseWise Healthcare Platform — Prisma schema (Phase 0, DRAFT for review)
// =============================================================================
//
// Conventions
// -----------
// * UUID primary keys everywhere (`@default(uuid())`).
// * Every tenant-owned row carries `organizationId` + a composite index that
//   leads with it. Tenant isolation is enforced in the application layer
//   (a Prisma Client extension) AND proven by the cross-tenant test suite;
//   Postgres RLS is a documented later hardening step (see MULTI_TENANCY.md).
// * Real foreign keys model the core clinical graph. "Actor" columns
//   (`createdById`, `updatedById`, `cancelledById`, `actorUserId`, …) are
//   plain indexed UUID strings — logical references to `User.id`, enforced at
//   the app layer — to keep the relation graph maintainable. This is
//   deliberate and documented in DATABASE_DESIGN.md.
// * Appointment instants are `timestamptz`. Medication reminder times are
//   stored as LOCAL wall-clock (`scheduledAtLocal`) + an IANA `timezone`
//   string, because "9:00 every day" must not drift when the device travels.
// * Double-booking is prevented by a Postgres EXCLUDE constraint added via
//   raw SQL — see prisma/sql/0001_appointment_no_overlap.sql. It is scoped by
//   (organizationId, doctorId, time range) so the SAME doctor may hold
//   overlapping appointments in DIFFERENT clinics, but never within one
//   clinic. Prisma cannot express EXCLUDE natively.
//
// TOOLCHAIN: targets Prisma 6.x — `url` / `directUrl` live in this datasource
// block (the Prisma <=6 idiom). Validated with `prisma@6 validate` + formatted
// with `prisma@6 format` (both pass, 2026-09-10). If the team later adopts
// Prisma 7, the datasource URLs move to a `prisma.config.ts` file — a
// mechanical change, no model edits.
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../.prisma-gen/out"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (PgBouncer) connection for the app
  directUrl = env("DIRECT_URL") // direct connection for migrations (Neon)
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum Role {
  PATIENT
  DOCTOR
  RECEPTIONIST
  CLINIC_ADMIN
  SUPER_ADMIN
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

// Fine-grained capabilities layered on top of a role. Empty by default.
// A role never implies clinical-record access on its own — it must be granted
// here (see RBAC.md / MEDICAL_DATA_SECURITY.md). DOCTOR clinical access is
// additionally gated by an assignment/consent link, not by this field alone.
enum MembershipCapability {
  CLINICAL_RECORD_READ // read consultation notes, prescription bodies, meds, vitals
  CLINICAL_RECORD_WRITE // create/amend clinical records
  BILLING_MANAGE // reserved (post-MVP)
  DATA_EXPORT // run clinic-wide exports
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  CHECKED_IN
  WAITING
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum BookingSource {
  PATIENT_APP
  RECEPTION
  DOCTOR
  ADMIN
  IMPORT
}

enum QueueState {
  WAITING
  CALLED
  IN_CONSULTATION
  COMPLETED
  SKIPPED
  /// Called but the patient did not answer. Kept OUT of the active order so the
  /// queue moves on, but deliberately distinct from SKIPPED: a held patient may
  /// still be brought back with RECALL (spec TOKEN_BOOKING_ASSESSMENT.md §3.4).
  HOLD
  /// The clinic concluded this patient did not attend. Terminal — not recallable.
  NO_SHOW
}

/// Which kinds of booking a doctor (and, for a given appointment, which one)
/// accepts. Per doctor — never a platform-wide switch (request §2).
enum BookingMode {
  SCHEDULED
  SAME_DAY_TOKEN
  BOTH
}

/// The booking mode a specific Appointment was created under. Lives on the
/// existing Appointment row rather than in a parallel table, so a token booking
/// is a first-class appointment (TOKEN_BOOKING_ASSESSMENT.md §2).
enum AppointmentBookingKind {
  SCHEDULED
  SAME_DAY_TOKEN
}

enum AvailabilityExceptionKind {
  DAY_OFF
  HOLIDAY
  LEAVE
  EXTRA_HOURS
  BREAK
}

enum DoseStatus {
  PENDING
  TAKEN
  SKIPPED
  MISSED
}

enum MedicationFrequency {
  DAILY
  SPECIFIC_DAYS
  ONCE
  MULTIPLE
}

enum FoodInstruction {
  NONE
  BEFORE
  AFTER
  WITH_FOOD
}

enum DocumentKind {
  PRESCRIPTION
  LAB_REPORT
  DISCHARGE_SUMMARY
  IMAGING
  INSURANCE
  OTHER
}

enum FamilyRelation {
  SELF
  SPOUSE
  FATHER
  MOTHER
  CHILD
  GUARDIAN
  OTHER
}

enum AccessPermission {
  VIEW_PROFILE
  VIEW_APPOINTMENTS
  MANAGE_APPOINTMENTS
  VIEW_MEDICATIONS
  MANAGE_MEDICATIONS
  VIEW_DOCUMENTS
}

enum InvitationScope {
  CLINIC_STAFF
  CLINIC_PATIENT
  FAMILY_ACCESS
}

enum VitalType {
  BLOOD_PRESSURE
  BLOOD_SUGAR
  WEIGHT
  TEMPERATURE
  HEART_RATE
}

enum NotificationChannel {
  PUSH
  EMAIL
  SMS
  WHATSAPP
  IN_APP
}

enum NotificationStatus {
  PENDING // due (or scheduled); eligible to be claimed by a dispatch run
  SENDING // claimed by a dispatch run; reaped back to PENDING if it goes stale
  SENT // delivered (terminal)
  FAILED // exhausted maxAttempts or a permanent error (terminal)
  SUPPRESSED // intentionally not delivered (recipient opted out)
}

// -----------------------------------------------------------------------------
// Tenancy & identity
// -----------------------------------------------------------------------------

enum OrganizationType {
  HOSPITAL
  CLINIC
  DIAGNOSTIC_CENTER
  POLYCLINIC
  OTHER
}

// Whether this org's public profile has been reviewed by the platform — a
// distinct concern from Organization.isActive, which is the superadmin
// suspend/reactivate switch (an inactive org is disabled outright; an
// unverified org can still operate and even be publicly listed, it just
// carries no "verified" badge yet). See PRODUCT_EVOLUTION_PLAN.md §15/§6.
enum OrganizationVerificationStatus {
  DRAFT
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  timezone  String   @default("Asia/Kolkata") // IANA; per-location tz overrides
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Public profile (PRODUCT_EVOLUTION_PLAN.md §6/§15 Phase 3) ---
  // All optional/defaulted so every existing row stays valid with no backfill.
  orgType            OrganizationType?
  tagline            String? // short one-line description
  about              String? // longer public "About" copy
  logoUrl            String?
  coverImageUrl      String?
  publicPhone        String?
  publicEmail        String?
  website            String?
  verificationStatus OrganizationVerificationStatus @default(DRAFT)
  isPubliclyListed   Boolean                        @default(false) // gate for public discovery (Phase 5)

  settings               ClinicSettings?
  locations              ClinicLocation[]
  memberships            Membership[]
  doctorProfiles         DoctorProfile[]
  staffProfiles          StaffProfile[]
  patients               Patient[]
  appointmentTypes       AppointmentType[]
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  verificationDocuments  VerificationDocument[]
  appointments           Appointment[]
  appointmentEvents      AppointmentEvent[]
  queueEntries           QueueEntry[]
  queueTokenCounters     QueueTokenCounter[]
  consultations          Consultation[]
  prescriptions          Prescription[]
  documents              MedicalDocument[]
  medications            Medication[]
  medicationDoses        MedicationDose[]
  vitalReadings          VitalReading[]
  familyRelationships    FamilyRelationship[]
  accessGrants           PatientAccessGrant[]
  invitations            Invitation[]
  notifications          Notification[]
  auditLogs              AuditLog[]
}

model ClinicSettings {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  allowPatientSelfBooking       Boolean  @default(true)
  bookingLeadTimeMinutes        Int      @default(120)
  cancellationWindowHours       Int      @default(4)
  maxAdvanceBookingDays         Int      @default(60)
  defaultAppointmentDurationMin Int      @default(15)
  localeDefault                 String   @default("en")
  supportedLocales              String[] @default(["en", "hi"])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClinicLocation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name         String
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?
  phone        String?
  timezone     String? // overrides Organization.timezone when set
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  appointments           Appointment[]
  queueEntries           QueueEntry[]

  @@index([organizationId])
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique // stored lower-cased; consider citext in prod
  passwordHash    String? // argon2id; null when the account is OAuth-only
  fullName        String
  phone           String?
  avatarUrl       String?
  locale          String    @default("en")
  isPlatformAdmin Boolean   @default(false) // backs SUPER_ADMIN, org-independent
  isGuest         Boolean   @default(false) // demo/preview session (GUEST_ACCESS.md)
  // Bumped by logout-all / password reset — invalidates outstanding access
  // tokens whose `tv` claim no longer matches (AUTHENTICATION.md R6).
  tokenVersion    Int       @default(0)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships              Membership[]
  identityAccounts         IdentityAccount[]
  sessions                 Session[]
  refreshTokens            RefreshToken[]
  ownedPatients            Patient[]              @relation("PatientOwner")
  guardianLinks            FamilyRelationship[]   @relation("FamilyGuardian")
  accessGrants             PatientAccessGrant[]   @relation("AccessGrantee")
  notifications            Notification[]
  uploadedVerificationDocs VerificationDocument[] @relation("VerificationDocumentUploader")
}

model IdentityAccount {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "google"
  providerAccountId String // Google `sub`
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashedSessionToken String   @unique // sha256 of the cookie value
  expiresAt          DateTime
  createdAt          DateTime @default(now())
  ip                 String?
  userAgent          String?

  @@index([userId])
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashedToken  String    @unique // sha256 of the raw refresh token
  familyId     String // rotation lineage; reuse of a revoked token nukes the family
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())
  ip           String?
  userAgent    String?

  @@index([userId])
  @@index([familyId])
}

model Membership {
  id             String                 @id @default(uuid())
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role
  status         MembershipStatus       @default(ACTIVE)
  // Capabilities layered on the role. Empty for every role by default —
  // notably CLINIC_ADMIN does NOT get clinical-record access unless
  // CLINICAL_RECORD_READ/WRITE is explicitly present here.
  capabilities   MembershipCapability[] @default([])
  invitedById    String? // logical -> User.id
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  doctorProfile DoctorProfile?
  staffProfile  StaffProfile?

  @@unique([userId, organizationId, role])
  @@index([organizationId, role])
}

model DoctorProfile {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  membershipId   String?      @unique
  membership     Membership?  @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  displayName             String
  specialty               String?
  registrationNumber      String?
  bio                     String?
  consultationDurationMin Int     @default(15)
  isAcceptingNewPatients  Boolean @default(true)
  isActive                Boolean @default(true)

  // --- Public profile (PRODUCT_EVOLUTION_PLAN.md §6/§15 Phase 4) ---
  photoUrl             String?
  qualifications       String? // free text for now, e.g. "MBBS, MD (Cardiology)"
  yearsOfExperience    Int?
  languages            String[] @default([])
  consultationFeeMinor Int? // currency minor units (e.g. paise); null = not published
  isPubliclyListed     Boolean  @default(false) // independent of Organization.isPubliclyListed

  // --- Booking policy (TOKEN_BOOKING_ASSESSMENT.md §3.1/§3.2) ---
  // Per doctor, not per clinic. SCHEDULED is the default so no existing
  // doctor's behaviour changes until someone opts in.
  bookingMode BookingMode @default(SCHEDULED)

  // Same-day token window, in MINUTES FROM CLINIC-LOCAL MIDNIGHT — the same
  // convention AvailabilityRule.startMinute/endMinute already uses, so these
  // need no new type. 07:00 / 11:00 / 09:00 are DEFAULTS, not a hardcoded
  // assumption: a clinic opening at 06:00 sets these itself. Ignored entirely
  // while bookingMode is SCHEDULED.
  tokenOpensMinute  Int @default(420) // 07:00
  tokenClosesMinute Int @default(660) // 11:00
  queueStartMinute  Int @default(540) // 09:00
  maxDailyTokens    Int @default(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  appointments           Appointment[]
  queueEntries           QueueEntry[]
  queueTokenCounters     QueueTokenCounter[]
  consultations          Consultation[]
  prescriptions          Prescription[]

  @@unique([organizationId, userId])
  @@index([organizationId])
}

model StaffProfile {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  membershipId   String?      @unique
  membership     Membership?  @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  jobTitle       String?
  isActive       Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId])
}

// -----------------------------------------------------------------------------
// Patients & family
// -----------------------------------------------------------------------------

model Patient {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // The self-managing user's account, when the patient runs their own care
  // (e.g. a migrated DoseWise user). Null for clinic-registered dependents.
  ownerUserId String?
  ownerUser   User?   @relation("PatientOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  mrn          String? // clinic medical record number
  firstName    String
  lastName     String
  dateOfBirth  DateTime? @db.Date
  sex          String?
  phone        String?
  email        String?
  addressLine1 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?
  bloodGroup   String?
  allergies    String? // free text for MVP; structured later
  notes        String?
  externalRef  String? // legacy import correlation
  isActive     Boolean   @default(true)

  createdById String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments    Appointment[]
  consultations   Consultation[]
  prescriptions   Prescription[]
  documents       MedicalDocument[]
  medications     Medication[]
  medicationDoses MedicationDose[]
  vitalReadings   VitalReading[]
  dependentLinks  FamilyRelationship[] @relation("FamilyDependent")
  accessGrants    PatientAccessGrant[]
  queueEntries    QueueEntry[]

  @@unique([organizationId, mrn])
  // At most one SELF-OWNED patient record per (org, user) — Postgres treats
  // NULL as distinct across rows, so this never restricts the many
  // clinic-registered dependents that have no ownerUserId at all. Backs the
  // self-service "become a patient of this clinic" upsert
  // (patient-booking/service.ts, PRODUCT_EVOLUTION_PLAN.md Phase 6).
  @@unique([organizationId, ownerUserId])
  @@index([organizationId, lastName])
}

model FamilyRelationship {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  guardianUserId     String
  guardianUser       User    @relation("FamilyGuardian", fields: [guardianUserId], references: [id], onDelete: Cascade)
  dependentPatientId String
  dependentPatient   Patient @relation("FamilyDependent", fields: [dependentPatientId], references: [id], onDelete: Cascade)

  relation    FamilyRelation
  createdById String
  createdAt   DateTime       @default(now())

  @@unique([guardianUserId, dependentPatientId])
  @@index([organizationId])
  @@index([dependentPatientId])
}

model PatientAccessGrant {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  patientId     String
  patient       Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  granteeUserId String
  granteeUser   User    @relation("AccessGrantee", fields: [granteeUserId], references: [id], onDelete: Cascade)

  permissions AccessPermission[]
  grantedById String
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime           @default(now())

  @@unique([patientId, granteeUserId])
  @@index([organizationId])
  @@index([granteeUserId])
}

model Invitation {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  scope       InvitationScope
  hashedToken String             @unique // sha256(rawToken); raw token lives only in the link/QR
  email       String?
  role        Role? // for CLINIC_STAFF
  patientId   String? // for CLINIC_PATIENT / FAMILY_ACCESS
  permissions AccessPermission[] // for FAMILY_ACCESS
  createdById String
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?
  revokedAt   DateTime?
  createdAt   DateTime           @default(now())

  @@index([organizationId, scope])
  @@index([expiresAt])
}

// -----------------------------------------------------------------------------
// Scheduling & appointments
// -----------------------------------------------------------------------------

model AppointmentType {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  durationMinutes Int
  colorHex        String?
  isActive        Boolean      @default(true)

  appointments Appointment[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model AvailabilityRule {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  doctorId       String
  doctor         DoctorProfile   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  locationId     String?
  location       ClinicLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  weekday       Int // ISO 1..7 (Mon=1), matches DoseWise DateTime.monday..sunday
  startMinute   Int // minutes from local midnight
  endMinute     Int
  slotMinutes   Int
  effectiveFrom DateTime? @db.Date
  effectiveTo   DateTime? @db.Date
  isActive      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, doctorId, weekday])
}

model AvailabilityException {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  doctorId       String
  doctor         DoctorProfile   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  locationId     String?
  location       ClinicLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  kind        AvailabilityExceptionKind
  startsAt    DateTime                  @db.Timestamptz(6)
  endsAt      DateTime                  @db.Timestamptz(6)
  reason      String?
  createdById String
  createdAt   DateTime                  @default(now())

  @@index([organizationId, doctorId, startsAt])
}

model Appointment {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  patientId         String
  patient           Patient          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctorId          String
  doctor            DoctorProfile    @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  locationId        String?
  location          ClinicLocation?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  appointmentTypeId String?
  appointmentType   AppointmentType? @relation(fields: [appointmentTypeId], references: [id], onDelete: SetNull)

  scheduledStart DateTime          @db.Timestamptz(6)
  scheduledEnd   DateTime          @db.Timestamptz(6)
  timezone       String // IANA snapshot of the clinic/location tz at booking
  status         AppointmentStatus @default(REQUESTED)
  reason         String?
  notes          String?
  bookingSource  BookingSource

  // Which booking mode produced this row (TOKEN_BOOKING_ASSESSMENT.md §3.3).
  // SCHEDULED = a real slot; SAME_DAY_TOKEN = a queue ticket for the clinic's
  // current day. Same table, same lifecycle — this is the only metadata needed
  // to tell them apart, and it also keeps token rows out of the appointment
  // double-booking EXCLUDE constraint (they all share the queue-start anchor).
  bookingKind AppointmentBookingKind @default(SCHEDULED)
  // Clinic-local calendar day this token belongs to (@db.Date). NULL for
  // scheduled appointments. A queue is a day concept; scheduledStart is an
  // instant, so the day has to be stored explicitly — and having it here is
  // what makes the "one active token per patient per doctor per day" partial
  // unique index expressible in plain SQL.
  tokenDate   DateTime?              @db.Date

  createdById String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  confirmedAt           DateTime?
  checkedInAt           DateTime?
  consultationStartedAt DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  cancelledById         String?
  cancellationReason    String?
  noShowMarkedAt        DateTime?

  // Reschedule lineage (self relation).
  rescheduledFromId String?      @unique
  rescheduledFrom   Appointment? @relation("Reschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo     Appointment? @relation("Reschedule")

  events       AppointmentEvent[]
  queueEntry   QueueEntry?
  consultation Consultation?

  @@index([organizationId, doctorId, scheduledStart])
  @@index([organizationId, patientId, scheduledStart])
  @@index([organizationId, status])
  @@index([organizationId, bookingKind, tokenDate])
}

model AppointmentEvent {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointmentId  String
  appointment    Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  fromStatus AppointmentStatus?
  toStatus   AppointmentStatus
  actorId    String? // logical -> User.id
  reason     String?
  metadata   Json?
  at         DateTime           @default(now())

  @@index([appointmentId])
  @@index([organizationId, at])
}

// -----------------------------------------------------------------------------
// Queue
// -----------------------------------------------------------------------------

model QueueEntry {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointmentId  String       @unique
  appointment    Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  patientId  String
  patient    Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctorId   String
  doctor     DoctorProfile   @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  locationId String?
  location   ClinicLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  queueDate   DateTime   @db.Date // clinic-local day
  tokenNumber Int
  state       QueueState @default(WAITING)
  position    Int
  recallCount Int        @default(0)

  checkedInAt           DateTime?
  calledAt              DateTime?
  consultationStartedAt DateTime?
  completedAt           DateTime?
  skippedAt             DateTime?
  heldAt                DateTime? // set when state -> HOLD; kept for the event log/UI

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, doctorId, queueDate, tokenNumber])
  @@index([organizationId, doctorId, queueDate, state, position])
  @@index([organizationId, doctorId, queueDate, tokenNumber])
}

/// Per-(org, doctor, clinic-local day) daily token sequence.
///
/// Token numbers are allocated with a single atomic
/// `INSERT … ON CONFLICT DO UPDATE … RETURNING` against this row instead of
/// `aggregate(_max) + 1`, so two patients racing at the exact opening minute
/// cannot receive the same number (TOKEN_BOOKING_ASSESSMENT.md §4.2).
///
/// Scope deliberately matches QueueEntry's existing
/// `@@unique([organizationId, doctorId, queueDate, tokenNumber])` — i.e. NOT
/// per location. Re-keying that constraint to include `locationId` would let the
/// counter and the constraint disagree.
model QueueTokenCounter {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  doctorId       String
  doctor         DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  queueDate      DateTime      @db.Date // clinic-local day
  lastToken      Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, doctorId, queueDate])
  @@index([organizationId, doctorId, queueDate])
}

// -----------------------------------------------------------------------------
// Clinical documentation
// -----------------------------------------------------------------------------

model Consultation {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointmentId  String        @unique
  appointment    Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctorId       String
  doctor         DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  // Structured SOAP-style notes. Free text only — NO AI / decision support.
  subjective   String?
  objective    String?
  assessment   String?
  plan         String?
  followUpDate DateTime? @db.Date
  testsAdvised String?
  instructions String?
  signedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prescriptions Prescription[]

  @@index([organizationId, patientId])
}

model Prescription {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctorId       String
  doctor         DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  issuedAt DateTime @default(now())
  notes    String?

  items PrescriptionItem[]

  @@index([organizationId, patientId])
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  drugName        String
  strength        String?
  form            String?
  dosage          String?
  frequency       String?
  durationDays    Int?
  foodInstruction FoodInstruction @default(NONE)
  instructions    String?

  @@index([prescriptionId])
}

model MedicalDocument {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)

  kind            DocumentKind
  title           String?
  storageProvider String // "s3" | "gcs" | "local-dev"
  storageKey      String
  mimeType        String
  sizeBytes       Int
  checksum        String?
  consultationId  String?
  uploadedById    String
  createdAt       DateTime     @default(now())

  @@index([organizationId, patientId, kind])
}

// -----------------------------------------------------------------------------
// Medication domain (migrated from DoseWise — patient-owned, offline-sync)
// -----------------------------------------------------------------------------

model Medication {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  ownerUserId    String? // self-managing user; gates clinic visibility

  name            String
  dosage          String              @default("")
  dosageUnit      String              @default("")
  notes           String              @default("")
  foodInstruction FoodInstruction     @default(NONE)
  frequency       MedicationFrequency @default(DAILY)
  selectedDays    Int[] // ISO weekday numbers 1..7
  onceDate        DateTime?           @db.Date
  isActive        Boolean             @default(true)
  stockCount      Int?
  refillAt        Int?

  source         String? // "dosewise-import" | "clinic" | "patient"
  legacyLocalId  Int? // DoseWise per-device autoincrement id
  sourceDeviceId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete = server-authoritative tombstone

  schedules MedicationSchedule[]
  doses     MedicationDose[]

  @@unique([sourceDeviceId, legacyLocalId])
  @@index([organizationId, patientId])
  @@index([patientId, isActive])
}

model MedicationSchedule {
  id           String     @id @default(uuid())
  medicationId String
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  hour         Int
  minute       Int
  enabled      Boolean    @default(true)

  @@index([medicationId])
}

model MedicationDose {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  medicationId   String
  medication     Medication   @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // LOCAL wall-clock reminder time (not an instant) + the zone it was set in.
  scheduledAtLocal DateTime
  timezone         String
  status           DoseStatus @default(PENDING)
  takenAt          DateTime?  @db.Timestamptz(6)
  skippedAt        DateTime?  @db.Timestamptz(6)
  snoozedUntil     DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([medicationId, scheduledAtLocal])
  @@index([patientId, scheduledAtLocal])
  @@index([medicationId, status])
}

model VitalReading {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  type        VitalType
  value       Float
  value2      Float? // diastolic for BLOOD_PRESSURE
  recordedAt  DateTime  @db.Timestamptz(6)
  notes       String?
  source      String? // "dosewise-import" | "patient" | "clinic"
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([organizationId, patientId, type, recordedAt])
}

// -----------------------------------------------------------------------------
// Platform: notifications & audit
// -----------------------------------------------------------------------------

model Notification {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  channel NotificationChannel
  event   String // "APPOINTMENT_CONFIRMED" | "QUEUE_UPDATE" | ...
  payload Json
  status  NotificationStatus  @default(PENDING)

  // Scheduling + reliable delivery (see NOTIFICATION_ARCHITECTURE.md).
  scheduledFor  DateTime? // becomes due at/after this instant; null = immediately
  dedupeKey     String?   @unique // deterministic key => idempotent creation
  attempts      Int       @default(0)
  maxAttempts   Int       @default(5)
  claimedAt     DateTime? // set on PENDING->SENDING; reaped if stale
  nextAttemptAt DateTime? // backoff target after a transient failure
  sentAt        DateTime?
  error         String?
  createdAt     DateTime  @default(now())

  // Read state for the in-app notification center (separate from `status`,
  // which tracks delivery/retry, not whether the recipient has seen it).
  readAt DateTime?

  @@index([status, scheduledFor])
  @@index([status, nextAttemptAt])
  @@index([userId])
  @@index([userId, channel, readAt])
}

/// Evidence a clinic attaches to its verification request (license,
/// registration certificate…). Bytes live in Postgres — no external object
/// storage in this phase; the table stays small because access is
/// CLINIC_ADMIN-of-this-org + platform-admin only and rows are capped (10 MB).
model VerificationDocument {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  fileName     String
  mimeType     String
  sizeBytes    Int
  data         Bytes
  uploadedById String
  uploadedBy   User     @relation("VerificationDocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@index([organizationId, createdAt])
}

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  actorUserId String?
  actorRole   Role?
  action      String // "APPOINTMENT_CREATED" | "PRESCRIPTION_CREATED" | ...
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?
  requestId   String?
  at          DateTime @default(now())

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, at])
  @@index([actorUserId])
}
